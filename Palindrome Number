class Solution {
    public boolean isPalindrome(int x) {
        if (x < 0) {
            return false;
        }

        int Original= x;
        int Reverse = 0;

        while (x > 0) {
            int Digit = x % 10;
            Reverse= Reverse * 10 + Digit;
            x = x / 10;
        }

        return Original == Reverse;
    }
}
